# ============================================================
# KONFIGURASI SUPABASE (WAJIB DIISI)
# ============================================================
# Dapatkan dari: Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
SUPABASE_TABLE=master_produk

# ============================================================
# KONFIGURASI DATABASE POSTGRESQL (UNTUK sync_master.py)
# ============================================================
# Format: postgresql://user:password@host:port/database
# Atau gunakan komponen terpisah:
DB_HOST=db.your-project.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=your-database-password

# ============================================================
# OPSIONAL: URL koneksi lengkap (alternatif dari komponen di atas)
# ============================================================
# DATABASE_URL=postgresql://user:pass@host:port/dbname?sslmode=require

# ============================================================
# OPSIONAL: Konfigurasi Aplikasi
# ============================================================
# APP_DEBUG=true
# LOG_LEVEL=INFO